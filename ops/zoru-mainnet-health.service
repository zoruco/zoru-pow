[Unit]
Description=ZORU mainnet status and native RAM
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/zoru-mainnet/release/deployment.json

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=zoru-mainnet-monitor
StateDirectoryMode=0700
Environment=PATH=/opt/zoru-mainnet/tools:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/zoru-mainnet/tools/monitor_mainnet.py --manifest /opt/zoru-mainnet/release/deployment.json --state /var/lib/zoru-mainnet-monitor --rpc https://vexascan.com/rpc --native https://vexascan.com:8443
CPUQuota=10%
MemoryMax=128M
TimeoutStartSec=90
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
